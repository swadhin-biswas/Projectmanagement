{
  "name": "research-project-management-server",
  "version": "1.0.0",
  "description": "Backend API for Research Project Management System",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.js",
    "start": "bun src/index.js",
    "debug": "bun --inspect src/index.js",
    "seed:superadmin": "bun src/scripts/seedSuperAdmin.js",
    "check-memory": "bun scripts/check-memory-leaks.js",
    "diagnose": "NODE_OPTIONS='--inspect' bun src/index.js",
    "logs:clear": "rm -rf logs/*",
    "logs:errors": "cat logs/error-*.log | tail -n 100"
  },
  "dependencies": {
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.2.0",
    "@elysiajs/swagger": "^1.2.2",
    "@libsql/client": "^0.15.2",
    "@node-rs/argon2": "^2.0.2",
    "@supabase/supabase-js": "^2.49.4",
    "axios": "^1.8.4",
    "chalk": "^4.1.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "elysia": "^1.2.25",
    "elysia-rate-limit": "^4.3.0",
    "express": "^5.1.0",
    "handlebars": "^4.7.8",
    "jose": "^6.0.10",
    "mongodb": "^6.15.0",
    "mongoose": "^8.13.2",
    "multer": "^1.4.5-lts.2",
    "multipart": "^0.1.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "pg": "^8.14.1",
    "pg-core": "^0.1.15",
    "pg-pool": "^3.8.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "whatwg-url": "^14.2.0",
    "winston": "latest",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9"
  }
}
