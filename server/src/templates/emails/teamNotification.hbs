<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Team Notification</title>
    <style>
      body { font-family: Arial, sans-serif; line-height: 1.6; color: #333;
      margin: 0; padding: 0; } .container { max-width: 600px; margin: 0 auto;
      padding: 20px; border: 1px solid #e0e0e0; border-radius: 5px; } .header {
      background-color: #4a5568; color: white; padding: 15px; text-align:
      center; border-radius: 5px 5px 0 0; } .content { padding: 20px;
      background-color: #f9f9f9; } .footer { text-align: center; padding: 10px;
      font-size: 12px; color: #718096; } .message { border-left: 3px solid
      #4299e1; padding-left: 15px; margin: 15px 0; } .button { display:
      inline-block; background-color: #4a5568; color: white; padding: 10px 20px;
      text-decoration: none; border-radius: 5px; margin-top: 15px; } .urgent {
      background-color: #e53e3e; color: white; padding: 3px 8px; border-radius:
      3px; font-size: 14px; display: inline-block; margin-bottom: 10px; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h2>Team Notification</h2>
      </div>
      <div class="content">
        <p>Hello Team {{teamName}},</p>

        {{#if isUrgent}}
          <div class="urgent">URGENT</div>
        {{/if}}

        <p>Your supervisor,
          <strong>{{supervisorName}}</strong>, has sent a message to the entire
          team:</p>

        <div class="message">
          {{message}}
        </div>

        {{#if dueDate}}
          <p><strong>Please address this by:</strong> {{dueDate}}</p>
        {{/if}}

        <p>You can view more details and respond to this notification in your
          project management dashboard.</p>

        <a href="{{dashboardUrl}}" class="button">Go to Dashboard</a>
      </div>
      <div class="footer">
        <p>This is an automated message, please do not reply directly to this
          email.</p>
        <p>&copy; {{year}} Project Management System</p>
      </div>
    </div>
  </body>
</html>